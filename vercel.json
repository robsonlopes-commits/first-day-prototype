    { "source": "/assets/ext/firstday.com/:path*", "destination": "https://firstday.com/:path*" },
    { "source": "/assets/ext/cdn.weglot.com/:path*", "destination": "https://cdn.weglot.com/:path*" },
    { "source": "/assets/ext/assets.app.thefrontrowhealth.com/:path*", "destination": "https://assets.app.thefrontrowhealth.com/:path*" },
    { "source": "/assets/ext/review-images.judgeme.com/:path*", "destination": "https://review-images.judgeme.com/:path*" },
